{
  "name": "WhatSync: reply to new WhatsApp messages",
  "nodes": [
    {
      "parameters": {
        "events": ["message.received"],
        "filters": { "chatType": "direct" }
      },
      "name": "WhatSync Trigger",
      "type": "n8n-nodes-whatsync.whatSyncTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "id": "0f7c1d2e-1111-4a5b-9c3d-000000000001",
      "webhookId": "0f7c1d2e-1111-4a5b-9c3d-000000000002"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "channel": "auto",
        "sendTo": "conversationId",
        "conversationId": "={{ $json.data.message.conversation_id }}",
        "text": "Thanks, we got your message and will reply soon.",
        "options": { "idempotencyKey": "={{ $json.id }}" }
      },
      "name": "WhatSync",
      "type": "n8n-nodes-whatsync.whatSync",
      "typeVersion": 1,
      "position": [260, 0],
      "id": "0f7c1d2e-1111-4a5b-9c3d-000000000003"
    }
  ],
  "connections": {
    "WhatSync Trigger": { "main": [[{ "node": "WhatSync", "type": "main", "index": 0 }]] }
  },
  "settings": {}
}
